  "grammarNotes": [
    {
      "id": "c10-u1-l3-g1",
      "title": "Ownership is one small word",
      "body": "నా = my, నీ = your (casual), మీ = your (respectful). They sit right before the thing owned: నా పేరు (my name), మీ ఇల్లు (your house)."
    }
