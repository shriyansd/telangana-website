    {
      "id": "c2u1t-e3",
      "type": "dialogue",
      "conceptIds": ["enough-chalu", "want-vaddu"],
      "newContext": true,
      "context": "She's about to serve you a third helping.",
      "turns": [
        { "speaker": "అత్త", "line": { "telugu": "ఇంకా కొంచెం?", "transliteration": "iṅkā koñchem?", "english": "A little more?" } }
      ],
      "responseMode": "select",
      "choices": [
        { "id": "a", "telugu": "చాలు, ధన్యవాదాలు!", "transliteration": "chālu, dhanyavādālu!", "english": "That's enough, thank you!" },
        { "id": "b", "telugu": "కాదు", "transliteration": "kādu", "whyWrong": "కాదు rejects an identity: for “no more food”, చాలు or వద్దు is the polite move." },
        { "id": "c", "telugu": "ఎక్కడ?", "whyWrong": "“Where?”: the dal is right in front of you." }
      ],
      "correctChoiceIds": ["a"],
      "feedback": { "grammar": "చాలు (enough) + thanks is the warm way to stop a generous host." }
    },
