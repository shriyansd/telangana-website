      "conceptIds": ["want-kavali", "word-water"],
      "newContext": true,
      "context": "You sit down to eat. Your aunt looks at your empty glass.",
      "turns": [
        { "speaker": "అత్త", "line": { "telugu": "ఏమి కావాలి?", "transliteration": "ēmi kāvāli?", "english": "What would you like?" } }
      ],
      "responseMode": "tiles",
      "tiles": ["నాకు", "నీళ్లు", "కావాలి"],
      "acceptedAnswers": ["నాకు నీళ్లు కావాలి"],
      "feedback": { "grammar": "The asking pattern: నాకు + thing + కావాలి." }
    },
    {
      "id": "c2u1t-e2",
      "type": "dialogue",
      "conceptIds": ["like-ishtam"],
      "newContext": true,
      "turns": [
