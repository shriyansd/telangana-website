      ],
      "responseMode": "select",
      "choices": [
        { "id": "a", "telugu": "అవును! నాకు పప్పు ఇష్టం", "transliteration": "avunu! nāku pappu iṣṭam", "english": "Yes! I like dal" },
        { "id": "b", "telugu": "అది మా అమ్మ", "whyWrong": "“That's my mom”, a surprising answer at dinner!" },
        { "id": "c", "telugu": "మీ పేరు ఏమిటి?", "whyWrong": "You know your aunt's name." }
      ],
      "correctChoiceIds": ["a"]
