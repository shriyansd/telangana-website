      "id": "c7l1-e1",
      "type": "listen_select",
      "conceptIds": ["come-here"],
      "prompt": "అమ్మమ్మ calls from the kitchen. What does she want you to do?",
      "audio": { "normal": "audio/course-7/c7-u1/ikkadiki-randi-normal.mp3", "slow": "audio/course-7/c7-u1/ikkadiki-randi-slow.mp3", "reviewStatus": "draft" },
      "spoken": { "telugu": "ఇక్కడికి రండి!", "transliteration": "ikkaḍiki raṇḍi!", "english": "come here!" },
      "choices": [
        { "id": "a", "english": "Come to her" },
        { "id": "b", "english": "Go outside", "whyWrong": "ఇక్కడికి means “to here” — she's calling you over." },
        { "id": "c", "english": "Sit down" }
      ],
      "correctChoiceIds": ["a"]
    },
    {
      "id": "c7l1-e2",
      "type": "dialogue",
      "conceptIds": ["hunger", "eat-respectful"],
      "prompt": "She's made పెసరట్టు. Answer her honestly — you're hungry!",
      "context": "In అమ్మమ్మ's kitchen",
      "turns": [
        { "speaker": "అమ్మమ్మ", "line": { "telugu": "ఆకలిగా ఉందా, నాన్నా?", "transliteration": "ākaligā undā, nānnā?", "english": "Are you hungry, dear?" } }
      ],
      "responseMode": "select",
      "choices": [
        { "id": "a", "telugu": "అవును అమ్మమ్మా, నాకు ఆకలిగా ఉంది!", "transliteration": "avunu ammammā, nāku ākaligā undi!", "english": "Yes grandma, I'm hungry!" },
        { "id": "b", "telugu": "కాదు.", "transliteration": "kādu.", "english": "It is not.", "whyWrong": "For “are you hungry?” the no would be లేదు — but you ARE hungry!" },
        { "id": "c", "telugu": "మీ పేరు ఏమిటి?", "english": "What is your name?", "whyWrong": "You know your grandmother's name!" }
      ],
      "correctChoiceIds": ["a"],
      "feedback": {
        "correct": "Note her నాన్నా — grandparents call grandchildren “little father/mother” as an endearment."
      }
    },
    {
      "id": "c7l1-e3",
      "type": "listen_select",
      "conceptIds": ["eat-respectful"],
      "prompt": "She sets the plate down and says…",
      "audio": { "normal": "audio/course-7/c7-u1/tinandi-normal.mp3", "reviewStatus": "draft" },
      "spoken": { "telugu": "తినండి, తినండి!", "transliteration": "tinaṇḍi, tinaṇḍi!", "english": "eat, eat!" },
      "choices": [
        { "id": "a", "english": "Eat!", "image": "🍽️" },
        { "id": "b", "english": "Drink!", "image": "🥤", "whyWrong": "Drink would be తాగండి. తినండి is eat." },
        { "id": "c", "english": "Sleep!", "image": "😴" }
      ],
      "correctChoiceIds": ["a"],
      "feedback": {
        "correct": "The doubled తినండి తినండి is pure Telugu-grandmother energy — refusing is not really an option."
      }
    },
    {
      "id": "c7l1-e4",
