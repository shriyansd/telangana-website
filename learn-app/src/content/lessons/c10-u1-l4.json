  "grammarNotes": [
    {
      "id": "c10-u1-l4-g1",
      "title": "ఉంది and its family",
      "body": "ఉంది = “it is / there is”. ఉన్నాను = “I am (somewhere)”. ఉన్నారు = “you are / they are” (respectful). And లేదు is its opposite: “there isn’t”."
    }
