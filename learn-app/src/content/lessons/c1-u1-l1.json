      "conceptIds": ["greet-good-morning"],
      "prompt": "Listen. What time of day is this greeting for?",
      "audio": { "normal": "audio/course-1/c1-u1/subhodayam-normal.mp3", "slow": "audio/course-1/c1-u1/subhodayam-slow.mp3", "reviewStatus": "draft" },
      "spoken": { "telugu": "శుభోదయం", "transliteration": "śubhōdayam", "english": "good morning" },
      "choices": [
        { "id": "a", "english": "Morning", "image": "🌅" },
        { "id": "b", "english": "Night", "image": "🌙" }
      ],
      "correctChoiceIds": ["a"],
      "feedback": {
        "correct": "శుభోదయం = śubha (auspicious) + udayam (sunrise) — a good morning.",
        "incorrect": "Listen for udayam — sunrise. శుభోదయం means good morning."
      }
    },
    {
      "id": "c1l1-e2",
      "type": "multiple_choice",
      "conceptIds": ["greet-goodbye"],
      "prompt": "Telugu speakers rarely say a flat “goodbye”. What does వెళ్ళొస్తాను literally promise?",
      "question": { "telugu": "వెళ్ళొస్తాను", "transliteration": "veḷḷostānu" },
      "choices": [
        { "id": "a", "english": "I'll go and come back" },
        { "id": "b", "english": "Go away", "whyWrong": "That would be rude — this word is warm, not dismissive." },
        { "id": "c", "english": "Good night" }
      ],
      "correctChoiceIds": ["a"],
      "feedback": {
        "correct": "Leaving is softened into a promise to return — వెళ్ళి + వస్తాను.",
        "grammar": "Compound verbs like this are everywhere in Telugu: two actions joined into one word."
      }
    },
