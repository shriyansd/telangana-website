  "cultureCards": [
    {
      "id": "cc-goodbye",
      "title": "Never just “bye”",
      "body": "Saying a final goodbye is considered inauspicious in Telugu homes. వెళ్ళొస్తాను — “I'll go and come back” — keeps the door open. Guests say it, hosts answer వెళ్ళిరండి — “go and return.”"
    }
