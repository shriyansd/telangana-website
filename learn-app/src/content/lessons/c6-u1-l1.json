  "exercises": [
    {
      "id": "c6l1-e1",
      "type": "script_build",
      "conceptIds": [
        "script-a"
      ],
      "prompt": "This is అ: the “a” in amma. Which letter is it?",
      "mode": "identify",
      "choices": [
        {
          "id": "a",
          "telugu": "అ"
        },
        {
          "id": "b",
          "telugu": "ఆ",
          "whyWrong": "Close! ఆ has an extra stroke: it's the long ā."
        },
        {
          "id": "c",
          "telugu": "ఇ"
        }
      ],
      "correctChoiceIds": [
        "a"
      ]
    },
    {
      "id": "c6l1-e2",
      "type": "script_build",
      "conceptIds": [
        "script-a",
        "script-aa"
      ],
      "prompt": "అ vs ఆ: which one is the LONG vowel, the “aa” in nānna?",
      "mode": "identify",
      "choices": [
        {
          "id": "a",
          "telugu": "ఆ"
        },
        {
          "id": "b",
          "telugu": "అ",
          "whyWrong": "అ is the short a. The extra hook on ఆ marks the long sound."
        }
      ],
      "correctChoiceIds": [
        "a"
      ],
      "feedback": {
        "correct": "Length matters in Telugu: అమ్మ (amma, mother) vs ఆమె (āme, she) start with different vowels."
      }
    },
    {
      "id": "c6l1-e3",
      "type": "script_build",
      "conceptIds": [
        "script-ka",
        "script-ka-matra"
      ],
      "prompt": "Combine: క (ka) + the ā vowel sign ా. What do you get?",
      "mode": "combine",
      "parts": [
        "క",
        "ా"
      ],
      "choices": [
        {
          "id": "a",
          "telugu": "కా",
          "transliteration": "kā"
        },
        {
          "id": "b",
          "telugu": "కి",
          "transliteration": "ki",
          "whyWrong": "కి uses the i-sign ి."
        },
        {
          "id": "c",
          "telugu": "క",
          "transliteration": "ka",
          "whyWrong": "Plain క keeps its built-in short a."
        }
      ],
      "correctChoiceIds": [
        "a"
      ],
      "feedback": {
        "correct": "Every consonant carries a built-in “a”. Vowel signs (guṇintālu) swap it: క → కా → కి → కు…"
      }
    },
    {
      "id": "c6l1-e4",
      "type": "script_build",
      "conceptIds": [
        "script-ma",
        "script-ka"
      ],
      "prompt": "Which letter says “ma”, the start of మామిడి (mango)?",
      "mode": "identify",
      "choices": [
        {
          "id": "a",
          "telugu": "మ"
        },
        {
          "id": "b",
          "telugu": "క"
        },
        {
          "id": "c",
          "telugu": "య"
        }
      ],
      "correctChoiceIds": [
        "a"
      ]
    },
    {
      "id": "c6l1-e5",
      "type": "script_build",
      "conceptIds": [
        "script-ma",
        "script-ka-matra"
      ],
      "prompt": "Build the word: “ammā”, అ + మ్మ + ా. Which is it?",
      "mode": "build-word",
      "parts": [
        "అ",
        "మ్మ",
        "ా"
      ],
      "choices": [
        {
          "id": "a",
          "telugu": "అమ్మా",
          "transliteration": "ammā"
        },
        {
          "id": "b",
          "telugu": "అమ్మి",
          "transliteration": "ammi",
          "whyWrong": "That ends with the i-sign."
        },
        {
          "id": "c",
          "telugu": "ఆమ్మ",
          "whyWrong": "The long ā belongs at the end here, not the start."
        }
      ],
      "correctChoiceIds": [
        "a"
      ],
      "feedback": {
        "correct": "You just read your first Telugu word: అమ్మా, mom! The doubled మ్మ uses a small attached మ (a vattu)."
      }
    },
