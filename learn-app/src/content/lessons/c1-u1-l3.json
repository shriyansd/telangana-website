      "id": "c1l3-e1",
      "type": "listen_select",
      "conceptIds": ["how-are-you"],
      "prompt": "Listen. How would you respond?",
      "audio": { "normal": "audio/course-1/c1-u1/ela-unnaru-normal.mp3", "slow": "audio/course-1/c1-u1/ela-unnaru-slow.mp3", "reviewStatus": "draft" },
      "spoken": { "telugu": "ఎలా ఉన్నారు?", "transliteration": "elā unnāru?", "english": "how are you?" },
      "choices": [
        { "id": "a", "telugu": "నేను బాగున్నాను", "transliteration": "nēnu bāgunnānu", "english": "I am fine" },
        { "id": "b", "telugu": "నా పేరు రవి", "transliteration": "nā pēru Ravi", "english": "My name is Ravi", "whyWrong": "That answers “what's your name?”: this question asks how you are." }
      ],
      "correctChoiceIds": ["a"],
      "feedback": {
        "correct": "ఎలా (how) ఉన్నారు (are you, respectful) → నేను బాగున్నాను (I am well)."
      }
    },
    {
      "id": "c1l3-e2",
      "type": "multiple_choice",
      "conceptIds": ["i-am-fine"],
      "prompt": "Which word inside నేను బాగున్నాను means “well / good”?",
      "question": { "telugu": "నేను బాగున్నాను", "transliteration": "nēnu bāgunnānu" },
      "choices": [
        { "id": "a", "telugu": "బాగు", "transliteration": "bāgu" },
        { "id": "b", "telugu": "నేను", "whyWrong": "నేను is the pronoun I." }
      ],
      "correctChoiceIds": ["a"],
      "feedback": {
        "grammar": "బాగు (well) + ఉన్నాను (I am) fuse into బాగున్నాను. Telugu loves joining words."
      }
    },
    {
      "id": "c1l3-e3",
      "type": "word_tiles",
      "conceptIds": ["i-am-fine"],
      "prompt": "Say “I am fine.”",
      "direction": "to-telugu",
      "source": { "telugu": "నేను బాగున్నాను", "transliteration": "nēnu bāgunnānu", "english": "I am fine" },
      "tiles": ["నేను", "బాగున్నాను"],
      "distractors": ["మీరు", "ఏమిటి"],
      "feedback": {
        "correct": "Subject first, verb last, the backbone of Telugu sentences."
      }
    },
    {
      "id": "c1l3-e4",
      "type": "dialogue",
      "conceptIds": ["how-are-you", "i-am-fine"],
      "prompt": "Your grandfather asks after you. Reply warmly.",
      "context": "On the phone with తాత",
      "turns": [
        { "speaker": "తాత", "line": { "telugu": "ఎలా ఉన్నావు, అమ్మా?", "transliteration": "elā unnāvu, ammā?", "english": "How are you, dear?" } }
      ],
      "responseMode": "select",
      "choices": [
        { "id": "a", "telugu": "బాగున్నాను తాతా! మీరు ఎలా ఉన్నారు?", "transliteration": "bāgunnānu tātā! mīru elā unnāru?", "english": "I'm fine, grandpa! How are you?" },
        { "id": "b", "telugu": "సరే.", "english": "Okay.", "whyWrong": "A bit cold for తాత! Tell him you're well, and ask him back." },
        { "id": "c", "telugu": "నా పేరు సీత.", "english": "My name is Sita.", "whyWrong": "He knows your name: he asked how you are." }
      ],
      "correctChoiceIds": ["a"],
      "feedback": {
        "correct": "Notice: తాత uses informal ఉన్నావు with you; you use respectful ఉన్నారు with him. That asymmetry is affection + respect."
      }
    },
    {
      "id": "c1l3-e5",
