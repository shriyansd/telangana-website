      "type": "sound_compare",
      "conceptIds": [
        "sound-ta-dental"
      ],
      "prompt": "Listen: soft త (tongue on teeth). Which letter did you hear?",
      "mode": "which-heard",
      "contrast": "త vs ట",
      "audio": {
        "normal": "audio/course-6/c6-u1/ta-dental-normal.mp3",
        "reviewStatus": "draft"
      },
      "spoken": {
        "telugu": "త",
        "transliteration": "ta"
      },
      "choices": [
        {
          "id": "a",
          "telugu": "త",
          "transliteration": "ta — soft, dental"
        },
        {
          "id": "b",
          "telugu": "ట",
          "transliteration": "ṭa — hard, retroflex",
          "whyWrong": "ట curls the tongue back to the roof of the mouth — a harder sound."
        }
      ],
      "correctChoiceIds": [
        "a"
      ],
      "feedback": {
        "correct": "త touches the teeth (like Spanish t); ట curls back. English “t” is between them — closer to ట."
      }
    },
