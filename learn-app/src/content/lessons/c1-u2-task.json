  "exercises": [
    {
      "id": "c1u2t-e1",
      "type": "dialogue",
      "conceptIds": ["fam-amma", "yes"],
      "newContext": true,
      "context": "A cousin calls. Someone walks past behind you.",
      "turns": [
        { "speaker": "బావ", "line": { "telugu": "అది మీ అమ్మ కదా?", "transliteration": "adi mī amma kadā?", "english": "That's your mom, isn't it?" } }
      ],
      "responseMode": "select",
      "choices": [
        { "id": "a", "telugu": "అవును, మా అమ్మ", "transliteration": "avunu, mā amma", "english": "Yes, my mom" },
        { "id": "b", "telugu": "లేదు", "transliteration": "lēdu", "whyWrong": "లేదు denies existence: for “yes it is her”, agree with అవును." },
        { "id": "c", "telugu": "వెళ్ళొస్తాను", "whyWrong": "That's goodbye!" }
      ],
      "correctChoiceIds": ["a"],
      "feedback": { "grammar": "మా అమ్మ (“our mom”) is how Telugu families naturally say “my mom”." }
    },
    {
      "id": "c1u2t-e2",
      "type": "dialogue",
      "conceptIds": ["no", "fam-nanna"],
      "newContext": true,
      "turns": [
        { "speaker": "బావ", "line": { "telugu": "అది మీ తాత?", "transliteration": "adi mī tāta?", "english": "Is that your grandfather?" } }
      ],
      "responseMode": "tiles",
      "tiles": ["కాదు", "మా", "నాన్న"],
      "acceptedAnswers": ["కాదు మా నాన్న"],
      "hint": "It is NOT grandfather, so start with the identity-no.",
      "feedback": { "grammar": "కాదు rejects an identity: “no, (that is) our dad.”" }
    },
    {
      "id": "c1u2t-e3",
      "type": "dialogue",
      "conceptIds": ["fam-ammamma"],
      "newContext": true,
      "turns": [
        { "speaker": "బావ", "line": { "telugu": "అమ్మమ్మ ఎలా ఉన్నారు?", "transliteration": "ammamma elā unnāru?", "english": "How is grandmother?" } }
      ],
      "responseMode": "select",
      "choices": [
        { "id": "a", "telugu": "బాగున్నారు", "transliteration": "bāgunnāru", "english": "She is well (respectful)" },
        { "id": "b", "telugu": "బాగున్నాను", "transliteration": "bāgunnānu", "whyWrong": "బాగున్నాను means *I* am fine, the question was about ammamma." },
        { "id": "c", "telugu": "సరే", "whyWrong": "సరే is “okay” for agreeing to something." }
      ],
      "correctChoiceIds": ["a"],
      "feedback": { "grammar": "-ఆరు endings show respect: ఉన్నారు, బాగున్నారు." }
    },
    {
      "id": "c1u2t-e4",
      "type": "dialogue",
      "conceptIds": ["okay", "greet-goodbye"],
      "newContext": true,
      "turns": [
        { "speaker": "బావ", "line": { "telugu": "సరే, రేపు మాట్లాడదాం!", "transliteration": "sarē, rēpu māṭlāḍadām!", "english": "Okay, let's talk tomorrow!" } }
      ],
      "responseMode": "type",
      "acceptedAnswers": ["సరే వెళ్ళొస్తాను", "సరే, వెళ్ళొస్తాను", "వెళ్ళొస్తాను", "sare vellostanu", "vellostanu"],
      "hint": "Agree (సరే), then the Telugu goodbye."
    }
