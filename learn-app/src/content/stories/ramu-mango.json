  "lines": [
    { "speaker": "కథ", "line": { "telugu": "రాము ఇంటికి వచ్చాడు.", "transliteration": "Rāmu iṇṭiki vachchāḍu.", "english": "Ramu came home.", "audio": { "normal": "audio/stories/ramu-mango/line-1.mp3", "reviewStatus": "draft" } } },
    { "speaker": "రాము", "line": { "telugu": "అమ్మమ్మా! నాకు ఆకలిగా ఉంది!", "transliteration": "ammammā! nāku ākaligā undi!", "english": "Grandma! I'm hungry!", "audio": { "normal": "audio/stories/ramu-mango/line-2.mp3", "reviewStatus": "draft" } } },
    { "speaker": "అమ్మమ్మ", "line": { "telugu": "రా నాన్నా. ఇది తీసుకో.", "transliteration": "rā nānnā. idi tīsukō.", "english": "Come, dear. Take this.", "audio": { "normal": "audio/stories/ramu-mango/line-3.mp3", "reviewStatus": "draft" } } },
    { "speaker": "రాము", "line": { "telugu": "ఇది ఏమిటి?", "transliteration": "idi ēmiṭi?", "english": "What is this?", "audio": { "normal": "audio/stories/ramu-mango/line-4.mp3", "reviewStatus": "draft" } } },
    { "speaker": "అమ్మమ్మ", "line": { "telugu": "మామిడిపండు! మన చెట్టుది.", "transliteration": "māmiḍipaṇḍu! mana cheṭṭudi.", "english": "A mango! From our own tree.", "audio": { "normal": "audio/stories/ramu-mango/line-5.mp3", "reviewStatus": "draft" } } },
    { "speaker": "రాము", "line": { "telugu": "చాలా తియ్యగా ఉంది! ఇంకా ఒకటి ఇవ్వండి!", "transliteration": "chālā tiyyagā undi! inkā okaṭi ivvaṇḍi!", "english": "It's so sweet! Please give me one more!", "audio": { "normal": "audio/stories/ramu-mango/line-6.mp3", "reviewStatus": "draft" } } },
    { "speaker": "అమ్మమ్మ", "line": { "telugu": "సరే సరే. ముందు అన్నం, తరువాత పండు!", "transliteration": "sarē sarē. mundu annam, taruvāta paṇḍu!", "english": "Okay, okay. First food, then fruit!", "audio": { "normal": "audio/stories/ramu-mango/line-7.mp3", "reviewStatus": "draft" } } }
  ],
