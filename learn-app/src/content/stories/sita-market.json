    { "speaker": "కథ", "line": { "telugu": "ఈరోజు ఆదివారం. సీత సంతకి వెళ్తుంది.", "transliteration": "īrōju ādivāram. Sīta santaki veḷtundi.", "english": "Today is Sunday. Sita goes to the market.", "audio": { "normal": "audio/stories/sita-market/line-1.mp3", "reviewStatus": "draft" } } },
    { "speaker": "సీత", "line": { "telugu": "నమస్కారం!", "transliteration": "namaskāram!", "english": "Hello!", "audio": { "normal": "audio/stories/sita-market/line-2.mp3", "reviewStatus": "draft" } } },
    { "speaker": "అంగడి అన్న", "line": { "telugu": "రండి రండి! ఏమి కావాలి?", "transliteration": "raṇḍi raṇḍi! ēmi kāvāli?", "english": "Come, come! What would you like?", "audio": { "normal": "audio/stories/sita-market/line-3.mp3", "reviewStatus": "draft" } } },
    { "speaker": "సీత", "line": { "telugu": "నాకు పండ్లు కావాలి.", "transliteration": "nāku paṇḍlu kāvāli.", "english": "I want some fruit.", "audio": { "normal": "audio/stories/sita-market/line-4.mp3", "reviewStatus": "draft" } } },
    { "speaker": "అంగడి అన్న", "line": { "telugu": "ఎన్ని కావాలి?", "transliteration": "enni kāvāli?", "english": "How many do you want?", "audio": { "normal": "audio/stories/sita-market/line-5.mp3", "reviewStatus": "draft" } } },
    { "speaker": "సీత", "line": { "telugu": "నాలుగు ఇవ్వండి.", "transliteration": "nālugu ivvaṇḍi.", "english": "Please give me four.", "audio": { "normal": "audio/stories/sita-market/line-6.mp3", "reviewStatus": "draft" } } },
    { "speaker": "అంగడి అన్న", "line": { "telugu": "ఇదిగో. నాలుగు పండ్లు.", "transliteration": "idigō. nālugu paṇḍlu.", "english": "Here you go. Four fruits.", "audio": { "normal": "audio/stories/sita-market/line-7.mp3", "reviewStatus": "draft" } } },
    { "speaker": "సీత", "line": { "telugu": "ధన్యవాదాలు! వెళ్ళొస్తాను!", "transliteration": "dhanyavādālu! veḷḷostānu!", "english": "Thank you! Goodbye!", "audio": { "normal": "audio/stories/sita-market/line-8.mp3", "reviewStatus": "draft" } } }
