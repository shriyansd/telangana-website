  "lines": [
    { "speaker": "కథ", "line": { "telugu": "ఉదయం అయింది.", "transliteration": "udayam ayindi.", "english": "It is morning.", "audio": { "normal": "audio/stories/anil-school/line-1.mp3", "reviewStatus": "draft" } } },
    { "speaker": "అమ్మ", "line": { "telugu": "శుభోదయం! లే, నాన్నా!", "transliteration": "śubhōdayam! lē, nānnā!", "english": "Good morning! Get up, dear!", "audio": { "normal": "audio/stories/anil-school/line-2.mp3", "reviewStatus": "draft" } } },
    { "speaker": "అనిల్", "line": { "telugu": "అమ్మా, ఈరోజు ఏమి వారం?", "transliteration": "ammā, īrōju ēmi vāram?", "english": "Mom, what day is it today?", "audio": { "normal": "audio/stories/anil-school/line-3.mp3", "reviewStatus": "draft" } } },
    { "speaker": "అమ్మ", "line": { "telugu": "ఈరోజు సోమవారం. బడి ఉంది!", "transliteration": "īrōju sōmavāram. baḍi undi!", "english": "Today is Monday. There's school!", "audio": { "normal": "audio/stories/anil-school/line-4.mp3", "reviewStatus": "draft" } } },
    { "speaker": "అనిల్", "line": { "telugu": "అయ్యో! నా పుస్తకం ఎక్కడ?", "transliteration": "ayyō! nā pustakam ekkaḍa?", "english": "Oh no! Where is my book?", "audio": { "normal": "audio/stories/anil-school/line-5.mp3", "reviewStatus": "draft" } } },
    { "speaker": "అమ్మ", "line": { "telugu": "మంచం మీద ఉంది. ముందు తినండి.", "transliteration": "mancham mīda undi. mundu tinaṇḍi.", "english": "It's on the bed. First, eat.", "audio": { "normal": "audio/stories/anil-school/line-6.mp3", "reviewStatus": "draft" } } },
    { "speaker": "అనిల్", "line": { "telugu": "సరే. నేను బడికి వెళ్తున్నాను! వెళ్ళొస్తాను!", "transliteration": "sarē. nēnu baḍiki veḷtunnānu! veḷḷostānu!", "english": "Okay. I'm going to school! Bye!", "audio": { "normal": "audio/stories/anil-school/line-7.mp3", "reviewStatus": "draft" } } },
    { "speaker": "అమ్మ", "line": { "telugu": "వెళ్ళిరా నాన్నా!", "transliteration": "veḷḷirā nānnā!", "english": "Go and come back, dear!", "audio": { "normal": "audio/stories/anil-school/line-8.mp3", "reviewStatus": "draft" } } }
  ],
